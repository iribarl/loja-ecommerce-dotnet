root = true

[*.cs]
# Identifiers that are keywords in other .NET languages (e.g. "Error" in VB).
# This codebase is C# only and is not consumed from other languages.
dotnet_diagnostic.CA1716.severity = none

# EF Core migrations are generated by dotnet-ef: analyzers should not ask to change them.
[**/Migrations/*.cs]
generated_code = true
