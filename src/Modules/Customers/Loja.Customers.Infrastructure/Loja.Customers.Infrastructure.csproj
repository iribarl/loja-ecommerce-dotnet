<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Customers are ASP.NET Core Identity users. Identity already provides the use cases
    (create user, check password, lockout...), so this module has only an Infrastructure layer
    for now; a Contracts project will expose customer data to other modules when they need it.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <!-- Only needed by the dotnet-ef tool at design time; not shipped to consumers. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Loja.Shared.Infrastructure\Loja.Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\Loja.Customers.Contracts\Loja.Customers.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Loja.IntegrationTests" />
  </ItemGroup>

</Project>
