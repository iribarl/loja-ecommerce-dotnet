@inject IThemeAccessor Theme

@* Store pages get the active theme's layout; pages that set their own (the admin panel) keep it. *@
<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="Theme.Current.Layout" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
