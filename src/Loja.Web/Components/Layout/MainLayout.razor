@inherits LayoutComponentBase
@using Loja.Cart.Application.GetCartUnits
@using Loja.Web.Cart
@using Loja.Customers.Infrastructure
@inject IServiceScopeFactory ScopeFactory

<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="/">Loja Demo</a>
        <form class="header-search" method="get" action="/produtos" role="search">
            <input type="search" name="q" placeholder="Buscar produtos" aria-label="Buscar produtos" />
        </form>
        <nav>
            <a href="/produtos">Produtos</a>
            @if (FirstName is { } firstName)
            {
                <a href="/conta">Olá, @firstName</a>
                @* POST with antiforgery token; a plain link would let other sites sign people out. *@
                <form method="post" action="/conta/sair" class="logout-form">
                    <AntiforgeryToken />
                    <button type="submit" class="link-button">Sair</button>
                </form>
            }
            else
            {
                <a href="@LoginUrl">Entrar</a>
            }
            <a href="/carrinho" class="cart-link">
                Carrinho
                @* Always rendered (hidden when empty) so js/cart.js can update it in place. *@
                <span class="cart-count" data-cart-count hidden="@(_cartUnits == 0)"
                      aria-label="@_cartUnits @(_cartUnits == 1 ? "item" : "itens") no carrinho">@_cartUnits</span>
            </a>
        </nav>
    </div>
</header>

<main class="container">
    @Body
</main>

<footer class="site-footer">
    <div class="container">
        Loja de demonstração para portfólio. Produtos, preços e pedidos são fictícios.
        · <a href="/privacidade">Política de Privacidade</a>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // The layout is rendered on the server for every page, so the count is fresh on each navigation.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private int _cartUnits;

    // From the sign-in cookie (see CustomerClaimsPrincipalFactory): no database query needed.
    private string? FirstName => HttpContext?.User.Identity?.IsAuthenticated == true
        ? HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
        : null;

    // After signing in, come back to the page the visitor was on.
    private string LoginUrl =>
        $"{CustomersModule.LoginPath}?{CustomersModule.ReturnUrlParameter}={Uri.EscapeDataString(HttpContext?.Request.Path.Value ?? "/")}";

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null)
        {
            return;
        }

        // Blazor does not wait for the layout before initializing the page, so both run at the same
        // time. The page may use the cart database too (e.g. /carrinho), and a DbContext cannot run
        // two operations at once: the layout gets its own scope and DbContext.
        await using var scope = ScopeFactory.CreateAsyncScope();
        var cartUnits = scope.ServiceProvider.GetRequiredService<GetCartUnitsHandler>();
        _cartUnits = await cartUnits.HandleAsync(CartCookie.OwnerOf(HttpContext), HttpContext.RequestAborted);
    }
}
