@using Loja.Catalog.Application.Products.GetProductBySlug

<div class="variant-selector">
    <p class="price">@Formatting.Price(DisplayedVariant.Price, DisplayedVariant.Currency)</p>

    @foreach (var (name, values) in Page.AttributeOptions)
    {
        <fieldset>
            <legend>@name: <strong>@_selection.GetValueOrDefault(name)</strong></legend>
            <div class="options">
                @foreach (var value in values)
                {
                    var isSelected = _selection.GetValueOrDefault(name) == value;
                    <button type="button"
                            class="option @(IsAvailable(name, value) ? "" : "unavailable")"
                            aria-pressed="@(isSelected ? "true" : "false")"
                            @onclick="() => Select(name, value)">
                        @value
                    </button>
                }
            </div>
        </fieldset>
    }

    @if (_selected is null)
    {
        <p class="stock sold-out">Combinação indisponível</p>
    }
    else
    {
        <p class="stock @(_selected.InStock ? "in-stock" : "sold-out")">
            @(_selected.InStock ? "Em estoque" : "Esgotado")
        </p>
        <p class="muted">SKU: @_selected.Sku</p>
    }

    @* The cart arrives in phase 2. *@
    <button type="button" disabled title="Em breve">Adicionar ao carrinho</button>
</div>

@code {
    [Parameter, EditorRequired]
    public ProductPageResponse Page { get; set; } = default!;

    private Dictionary<string, string> _selection = [];
    private VariantDetails? _selected;

    private IReadOnlyList<VariantDetails> Variants => Page.Product.Variants;

    // While the selection matches no variant, keep showing the price of the first one.
    private VariantDetails DisplayedVariant => _selected ?? Variants[0];

    protected override void OnParametersSet()
    {
        // Start with the first variant in stock, so the shopper sees something they can buy.
        var initial = Variants.FirstOrDefault(v => v.InStock) ?? Variants[0];
        _selection = new Dictionary<string, string>(initial.Attributes, StringComparer.Ordinal);
        _selected = initial;
    }

    private void Select(string attribute, string value)
    {
        _selection[attribute] = value;
        _selected = Variants.FirstOrDefault(Matches);
    }

    private bool Matches(VariantDetails variant) =>
        variant.Attributes.Count == _selection.Count
        && _selection.All(pair => variant.Attributes.TryGetValue(pair.Key, out var value) && value == pair.Value);

    // A value is available when, keeping the other choices, some variant with it is in stock.
    private bool IsAvailable(string attribute, string value) =>
        Variants.Any(variant =>
            variant.InStock
            && variant.Attributes.TryGetValue(attribute, out var own) && own == value
            && _selection.Where(pair => pair.Key != attribute)
                .All(pair => variant.Attributes.TryGetValue(pair.Key, out var other) && other == pair.Value));
}
