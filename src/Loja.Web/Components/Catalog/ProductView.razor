@using Loja.Catalog.Application.Products.GetProductBySlug
@using Loja.Catalog.Application.Products.Images
@using Loja.Cart.Application
@using Loja.Cart.Application.AddToCart

@*
    Interactive part of the product page: picture, variant selector, price and stock change
    together with the shopper's choices. It receives the data as a parameter, so becoming
    interactive does not query the database again.
*@

<div class="product-page">
    @* Every picture, swipeable, with thumbnails; picking a variant brings its picture (js/gallery.js). *@
    @* Clicking a picture opens it full screen (the dialog below, js/gallery.js). *@
    <div class="gallery" data-gallery data-lightbox="product-lightbox" @ref="_gallery">
        <div class="gallery-track" data-gallery-track tabindex="0" aria-label="Fotos de @Page.Product.Name">
            @for (var i = 0; i < Images.Count; i++)
            {
                var image = Images[i];
                <img src="@ImageSizes.For(image.Url, ImageSizes.Large)" srcset="@ImageSizes.SrcSet(image.Url)"
                     sizes="(max-width: 720px) 100vw, 560px" alt="@AltFor(image)" width="1200" height="1200"
                     loading="@(i == 0 ? "eager" : "lazy")" data-lightbox-open title="Ampliar foto" />
            }
        </div>
        @if (Images.Count > 1)
        {
            <button type="button" class="gallery-prev" data-gallery-prev aria-label="Foto anterior">‹</button>
            <button type="button" class="gallery-next" data-gallery-next aria-label="Próxima foto">›</button>
            <div class="gallery-thumbs">
                @for (var i = 0; i < Images.Count; i++)
                {
                    <button type="button" data-gallery-go="@i" aria-current="@(i == 0 ? "true" : "false")" aria-label="Foto @(i + 1) de @Images.Count">
                        <img src="@ImageSizes.For(Images[i].Url, ImageSizes.Thumbnail)" alt="" width="160" height="160" loading="lazy" />
                    </button>
                }
            </div>
        }
    </div>

    @* A native modal dialog: the browser keeps the focus inside, closes it with Esc and hides the page behind it from screen readers. *@
    @if (Images.Count > 0)
    {
        <dialog id="product-lightbox" class="lightbox" aria-label="Fotos de @Page.Product.Name">
            <div class="gallery lightbox-gallery" data-gallery>
                <div class="gallery-track" data-gallery-track tabindex="0">
                    @foreach (var image in Images)
                    {
                        <img src="@ImageSizes.For(image.Url, ImageSizes.Large)" srcset="@ImageSizes.SrcSet(image.Url)"
                             sizes="100vw" alt="@AltFor(image)" loading="lazy" />
                    }
                </div>
                @if (Images.Count > 1)
                {
                    <button type="button" class="gallery-prev" data-gallery-prev aria-label="Foto anterior">‹</button>
                    <button type="button" class="gallery-next" data-gallery-next aria-label="Próxima foto">›</button>
                    <p class="lightbox-counter" aria-live="polite"><span data-gallery-position>1</span> / @Images.Count</p>
                }
            </div>
            <button type="button" class="lightbox-close" data-lightbox-close aria-label="Fechar">×</button>
        </dialog>
    }

    <div>
        <h1>@Page.Product.Name</h1>

        <div class="variant-selector">
            <p class="price">@Formatting.Price(DisplayedVariant.Price, DisplayedVariant.Currency)</p>

            @foreach (var (name, values) in Page.AttributeOptions)
            {
                <fieldset>
                    <legend>@name: <strong>@_selection.GetValueOrDefault(name)</strong></legend>
                    <div class="options">
                        @foreach (var value in values)
                        {
                            var isSelected = _selection.GetValueOrDefault(name) == value;
                            <button type="button"
                                    class="option @(IsAvailable(name, value) ? "" : "unavailable")"
                                    aria-pressed="@(isSelected ? "true" : "false")"
                                    @onclick="() => Select(name, value)">
                                @value
                            </button>
                        }
                    </div>
                </fieldset>
            }

            @if (_selected is null)
            {
                <p class="stock sold-out">Combinação indisponível</p>
            }
            else if (!_selected.InStock)
            {
                <p class="stock sold-out">Esgotado</p>
            }
            else if (_selected.RemainingUnits is { } units)
            {
                <p class="stock low-stock">@(units == 1 ? "Última unidade!" : $"Últimas {units} unidades!")</p>
            }
            else
            {
                <p class="stock in-stock">Em estoque</p>
            }

            @if (_selected is not null)
            {
                <p class="muted">SKU: @_selected.Sku</p>
            }

            <div class="add-to-cart">
                <label>
                    Quantidade
                    <select @bind="_quantity" disabled="@(!CanAdd)">
                        @for (var quantity = 1; quantity <= MaxQuantity; quantity++)
                        {
                            <option value="@quantity">@quantity</option>
                        }
                    </select>
                </label>
                <button type="button" disabled="@(!CanAdd || _adding)" @onclick="AddToCartAsync">
                    @(_adding ? "Adicionando..." : "Adicionar ao carrinho")
                </button>
            </div>

            @if (_addError is not null)
            {
                <p class="alert">@_addError</p>
            }
            else if (_cartUnits is { } units)
            {
                <p class="added" role="status">
                    Adicionado ao carrinho! <a href="/carrinho">Ver carrinho (@units @(units == 1 ? "item" : "itens"))</a>
                </p>
            }
        </div>

        <p class="description">@Page.Product.Description</p>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ProductPageResponse Page { get; set; } = default!;

    /// <summary>
    /// The visitor's cart, read from the cookie by the (static) page: this component runs over
    /// SignalR and has no access to cookies. Blazor encrypts the parameters of interactive components.
    /// </summary>
    [Parameter, EditorRequired]
    public CartOwner Owner { get; set; } = default!;

    [Inject]
    private IServiceScopeFactory ScopeFactory { get; set; } = default!;

    // Updates the static header's cart count (see wwwroot/js/cart.js).
    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private Dictionary<string, string> _selection = [];
    private VariantDetails? _selected;
    private int _quantity = 1;
    private bool _adding;
    private string? _addError;
    private int? _cartUnits;

    private bool CanAdd => _selected is { InStock: true };

    // When few units are left, do not offer more than there are.
    private int MaxQuantity => _selected?.RemainingUnits ?? CartRules.MaxUnitsPerItem;

    private async Task AddToCartAsync()
    {
        if (_selected is null)
        {
            return;
        }

        _adding = true;
        _addError = null;

        // A fresh scope (and DbContext) per click: this component lives as long as the
        // SignalR connection, and a long-lived DbContext would keep tracking stale entities.
        await using var scope = ScopeFactory.CreateAsyncScope();
        var addToCart = scope.ServiceProvider.GetRequiredService<AddToCartHandler>();
        var result = await addToCart.HandleAsync(Owner, _selected.Id, _quantity, CancellationToken.None);

        if (result.IsSuccess)
        {
            _cartUnits = result.Value;
            await JS.InvokeVoidAsync("lojaCart.setUnits", result.Value);
        }
        else
        {
            _addError = result.Error.Message;
            _cartUnits = null;
        }

        _adding = false;
    }

    private IReadOnlyList<VariantDetails> Variants => Page.Product.Variants;

    // While the selection matches no variant, keep showing the price of the first one.
    private VariantDetails DisplayedVariant => _selected ?? Variants[0];

    private IReadOnlyList<ProductImageDetails> Images => Page.Product.Images;

    private ElementReference _gallery;

    private string AltFor(ProductImageDetails image) => image.AppliesTo.Count == 0
        ? Page.Product.Name
        : $"{Page.Product.Name} - {string.Join(", ", image.AppliesTo.Values)}";

    // The picture of the selected variant (e.g. the black one when "Preto" is picked) comes into view.
    private int ImageIndexForSelection() =>
        Page.ImageFor(_selection) is { } image ? Math.Max(0, Images.ToList().IndexOf(image)) : 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The page is first rendered on the server, showing the first picture; once interactive,
        // bring the initial variant's picture into view.
        if (firstRender && Images.Count > 1)
        {
            await JS.InvokeVoidAsync("lojaGallery.show", _gallery, ImageIndexForSelection());
        }
    }

    protected override void OnParametersSet()
    {
        // Start with the first variant in stock, so the shopper sees something they can buy.
        var initial = Variants.FirstOrDefault(v => v.InStock) ?? Variants[0];
        _selection = new Dictionary<string, string>(initial.Attributes, StringComparer.Ordinal);
        _selected = initial;
    }

    private async Task Select(string attribute, string value)
    {
        _selection[attribute] = value;
        _selected = Variants.FirstOrDefault(Matches);
        _quantity = 1;
        _cartUnits = null;
        _addError = null;

        if (Images.Count > 1)
        {
            await JS.InvokeVoidAsync("lojaGallery.show", _gallery, ImageIndexForSelection());
        }
    }

    private bool Matches(VariantDetails variant) =>
        variant.Attributes.Count == _selection.Count
        && _selection.All(pair => variant.Attributes.TryGetValue(pair.Key, out var value) && value == pair.Value);

    // A value is available when, keeping the other choices, some variant with it is in stock.
    private bool IsAvailable(string attribute, string value) =>
        Variants.Any(variant =>
            variant.InStock
            && variant.Attributes.TryGetValue(attribute, out var own) && own == value
            && _selection.Where(pair => pair.Key != attribute)
                .All(pair => variant.Attributes.TryGetValue(pair.Key, out var other) && other == pair.Value));
}
