@using Loja.Catalog.Application.Products.Images

@*
    The pictures swipe inside the card (js/gallery.js adds arrows on hover). The arrows sit
    outside the links: a button inside a link is invalid HTML and would also open the product.
*@

<li class="product-card">
    <div class="gallery card-gallery" data-gallery>
        <a href="/produtos/@Product.Slug" class="gallery-track" data-gallery-track tabindex="-1" aria-label="@Product.Name">
            @for (var i = 0; i < Product.Images.Count; i++)
            {
                var image = Product.Images[i];
                <img src="@ImageSizes.For(image, ImageSizes.Card)" srcset="@ImageSizes.SrcSet(image)" sizes="@Sizes"
                     alt="@(i == 0 ? Product.Name : "")" loading="lazy" width="480" height="480" />
            }
        </a>
        @if (Product.Images.Count > 1)
        {
            <button type="button" class="gallery-prev" data-gallery-prev aria-label="Foto anterior de @Product.Name">‹</button>
            <button type="button" class="gallery-next" data-gallery-next aria-label="Próxima foto de @Product.Name">›</button>
            <span class="gallery-dots" aria-hidden="true">
                @for (var i = 0; i < Product.Images.Count; i++)
                {
                    <span data-gallery-dot="@i" data-active="@(i == 0)"></span>
                }
            </span>
        }
    </div>
    <a href="/produtos/@Product.Slug">
        <div class="info">
            <h2>@Product.Name</h2>
            <span class="muted">@Product.CategoryName</span>
            <p class="price">@Formatting.Price(Product.MinPrice, Product.Currency)</p>
            @if (!Product.InStock)
            {
                <span class="badge">Esgotado</span>
            }
        </div>
    </a>
</li>

@code {
    // Cards are about a quarter of the page wide, half on phones.
    private const string Sizes = "(max-width: 720px) 50vw, 280px";

    [Parameter, EditorRequired]
    public ProductSummary Product { get; set; } = default!;
}
