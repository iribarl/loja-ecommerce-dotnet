@page "/not-found"
@inject IThemeAccessor Theme

@* Also shown by the router for unknown addresses, so it sets the theme's layout itself. *@
<LayoutView Layout="Theme.Current.Layout">
    <PageTitle>Página não encontrada</PageTitle>

    <h1>Página não encontrada</h1>
    <p>Desculpe, o conteúdo que você procura não existe.</p>
</LayoutView>
