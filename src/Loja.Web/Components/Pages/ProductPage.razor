@page "/produtos/{Slug}"
@using Loja.Catalog.Application.Products.GetProductBySlug
@using Loja.Web.Cart
@inject GetProductBySlugHandler GetProduct
@inject NavigationManager Navigation
@inject IThemeAccessor Theme

@*
    The page itself is static server rendering: one database query and crawlable HTML.
    Only the product view (from the active theme) is interactive.
*@

@if (_page is { } page)
{
    var product = page.Product;

    <PageTitle>@product.Name | Loja Demo</PageTitle>

    <nav class="breadcrumb" aria-label="Navegação">
        <a href="/produtos">Produtos</a> /
        <a href="/produtos?categoria=@product.CategorySlug">@product.CategoryName</a> /
        <span>@product.Name</span>
    </nav>

    @* The active theme's product view, interactive: price and stock follow the shopper's choices. *@
    <ThemeComponent Type="Theme.Current.ProductView" RenderMode="InteractiveServer"
                    Parameters="@(new Dictionary<string, object?> { ["Page"] = page, ["Owner"] = CartCookie.OwnerOf(HttpContext!) })" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private ProductPageResponse? _page;

    protected override async Task OnInitializedAsync()
    {
        var result = await GetProduct.HandleAsync(Slug, HttpContext?.RequestAborted ?? default);

        if (result.IsSuccess)
        {
            _page = result.Value;
        }
        else
        {
            // Renders the router's NotFoundPage with a 404 status code.
            Navigation.NotFound();
        }
    }
}
