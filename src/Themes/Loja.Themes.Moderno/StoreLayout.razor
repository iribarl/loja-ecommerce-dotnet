@inherits StoreLayoutBase

<div class="mod-announcement">Frete grátis a partir de R$ 299 para todo o Brasil</div>

<header class="mod-header">
    <div class="container mod-header-inner">
        <nav class="mod-nav-left" aria-label="Loja">
            <a href="/produtos">Loja</a>
            <form class="mod-search" method="get" action="/produtos" role="search">
                <input type="search" name="q" placeholder="Buscar" aria-label="Buscar produtos" />
            </form>
        </nav>

        <a class="mod-brand" href="/">Loja<span>Demo</span></a>

        <nav class="mod-nav-right" aria-label="Conta">
            @if (Session.IsSignedIn)
            {
                @if (Session.IsAdmin)
                {
                    <a href="/admin">Painel</a>
                }
                <a href="/conta">@Session.FirstName</a>
                <form method="post" action="@StoreSession.LogoutUrl" class="logout-form">
                    <AntiforgeryToken />
                    <button type="submit" class="link-button">Sair</button>
                </form>
            }
            else
            {
                <a href="@Session.LoginUrl">Entrar</a>
            }
            <a href="/carrinho" class="mod-cart">
                Sacola
                @* Always rendered (hidden when empty) so js/cart.js can update it in place. *@
                <span class="cart-count" data-cart-count hidden="@(Session.CartUnits == 0)"
                      aria-label="@Session.CartUnits @(Session.CartUnits == 1 ? "item" : "itens") no carrinho">@Session.CartUnits</span>
            </a>
        </nav>
    </div>
</header>

<main class="container mod-main">
    @Body
</main>

<footer class="mod-footer">
    <div class="container mod-footer-grid">
        <div>
            <p class="mod-brand mod-brand-footer">Loja<span>Demo</span></p>
            <p>Loja de demonstração para portfólio. Produtos, preços e pedidos são fictícios.</p>
        </div>
        <div>
            <h2>Comprar</h2>
            <a href="/produtos">Todos os produtos</a>
            <a href="/carrinho">Sacola</a>
        </div>
        <div>
            <h2>Ajuda</h2>
            <a href="/conta">Minha conta</a>
            <a href="/privacidade">Política de Privacidade</a>
        </div>
    </div>
</footer>

<StoreErrorUi />
